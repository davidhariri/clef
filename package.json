{
  "name": "clef",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "chat": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome check --error-on-warnings .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run boundaries && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-codemode": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@streamdown/code": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "ai": "7.0.127",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eventsource": "5.1.2",
    "fastify": "5.12.5",
    "guarded-fetch": "0.1.5",
    "lucide-react": "1.51.0",
    "nanoid": "6.0.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.5.0",
    "postcss": "8.5.28",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
