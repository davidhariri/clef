{
  "name": "@davidhariri/clef",
  "version": "0.0.1",
  "description": "A self-hosted personal AI assistant with a web interface.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clef": "lib/server/main.js"
  },
  "files": [
    "INSTALLATION.md",
    "lib/",
    "dist/",
    "src/web/components/upstream/LICENSE-AI-ELEMENTS",
    "src/web/components/upstream/LICENSE-SHADCN",
    "src/web/components/upstream/UPSTREAM.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidhariri/clef.git"
  },
  "homepage": "https://github.com/davidhariri/clef#readme",
  "bugs": {
    "url": "https://github.com/davidhariri/clef/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts serve",
    "build": "rm -rf lib && vite build && tsc --project tsconfig.build.json",
    "start": "node lib/server/main.js serve",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome check --error-on-warnings .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "check:fast": "npm run lint && npm run boundaries && npm run typecheck && npm test",
    "check": "npm run check:fast && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-codemode": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "guarded-fetch": "0.1.5",
    "yaml": "2.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@playwright/test": "1.63.0",
    "@streamdown/code": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.127",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dependency-cruiser": "18.5.0",
    "lucide-react": "1.51.0",
    "nanoid": "6.0.1",
    "postcss": "8.5.28",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
